# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: chuoi ket noi PostgreSQL cua du an Supabase.
# Dung cho nut "Chay cap nhat tu dong" trong admin (Cai dat > Co so du lieu)
# va cho cac script trong thu muc scripts/.
#
# Lay tai: Supabase Dashboard > Project Settings > Database > Connection string
# PHAI chon tab "Session pooler". Chuoi ket noi truc tiep (db.<ref>.supabase.co)
# chi ho tro IPv6 nen ham serverless cua Vercel khong goi toi duoc.
#
# Dang: postgresql://postgres.<ref>:<mat_khau>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: dung de kiem tra quyen admin o phia server
# (api/users/create.ts va api/db/migrate.ts).
SUPABASE_SERVICE_ROLE_KEY=
